{
  "expo": {
    "name": "SafeRide",
    "slug": "saferide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/saferide-icon.png",
    "scheme": "saferide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/saferide-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f8f6"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/saferide-icon.png",
        "backgroundColor": "#f5f8f6"
      }
    },
    "web": {
      "favicon": "./assets/images/saferide-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SafeRide needs your location to track your journey and provide real-time safety monitoring.",
          "locationAlwaysPermission": "SafeRide needs background location access to monitor your journey even when the app is in the background.",
          "locationWhenInUsePermission": "SafeRide needs your location to track your journey and provide safety monitoring."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
